{
  "name": "fed-chairman-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "native:generate": "cd native/FedChairmanGame && xcodegen generate",
    "typecheck": "cd native/FedChairmanGame && swift build",
    "lint": "cd native/FedChairmanGame && swiftformat Sources Tests --swift-version 6.1 --lint && swiftlint lint --strict",
    "test": "cd native/FedChairmanGame && swift test",
    "test:fast": "scripts/native-validation.sh fast",
    "test:gui": "scripts/agentic-gui-verify.sh",
    "test:ui": "scripts/native-validation.sh ui-final",
    "test:ui:preflight": "scripts/native-validation.sh ui-preflight",
    "test:ui:prepare": "scripts/native-validation.sh ui-prepare",
    "test:ui:one": "scripts/native-validation.sh ui-one",
    "test:ui:final": "scripts/native-validation.sh ui-final",
    "verify:desktop": "npm run lint && npm test && npm run test:gui",
    "verify:desktop:xcuitest": "npm run lint && npm test && npm run test:ui:final",
    "build": "cd native/FedChairmanGame && scripts/package-native-release-candidate.sh",
    "install:mac": "cd native/FedChairmanGame && scripts/package-native-release-candidate.sh --install",
    "package:mac": "cd native/FedChairmanGame && scripts/package-native-release-candidate.sh",
    "package:mac:xcuitest": "cd native/FedChairmanGame && scripts/package-native-release-candidate.sh --with-xcuitest",
    "package:production": "cd native/FedChairmanGame && scripts/package-native-production.sh",
    "package:production:xcuitest": "cd native/FedChairmanGame && scripts/package-native-production.sh --with-xcuitest"
  }
}
